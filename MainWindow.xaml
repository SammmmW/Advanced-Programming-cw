<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock Name="Prompt" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="Please input an expression:" FontSize="50" VerticalAlignment="Top"/>
        <TextBox Name="Input" MaxLength="32" Margin="10,77,10,280" />
        <TextBlock Name="Info" HorizontalAlignment="Left" Margin="0,163,0,0" TextWrapping="Wrap" FontSize="20" VerticalAlignment="Top" Width="303" Height="261"/>
        <Button Name="Btn" Content="Evaluate Expression" FontSize="20" Width="184" Height="100" HorizontalAlignment="Center" Margin="0,159,0,0" VerticalAlignment="Top" Click="Btn_Click"/>
        <Button Name="Help" Content="Info" FontSize="20" Width="67" Height="62" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Click="Help_Click"/>
        <TextBlock Name="Result" HorizontalAlignment="Center" Margin="0,300,0,0" TextWrapping="Wrap" FontSize="30" VerticalAlignment="Top"/>
        <TextBlock Name="Error" HorizontalAlignment="Center" Margin="0,200,0,0" TextWrapping="Wrap" FontSize="30" VerticalAlignment="Top"/>
    </Grid>
</Window>
